# Example environment file for mijia-server
# Copy to /etc/mijia-server.env and adjust as needed.
# Variable names match README and Docker (Dockerfile ENV).

MIJIA_SERVER_HOST=127.0.0.1
MIJIA_SERVER_PORT=8123
MIJIA_SERVER_DATA_DIR=/opt/mijia_server/configs
MIJIA_SERVER_DATABASE_PATH=/opt/mijia_server/configs/server/server.sqlite3
MIJIA_CREDENTIAL_PATH=/opt/mijia_server/configs/credential.json
MIJIA_WEB_DIST_DIR=/opt/mijia_server/web/dist
# MIJIA_SERVER_LOG_LEVEL=INFO
# Optional: override credential encryption secret (otherwise configs/.credential_key is used)
# MIJIA_CREDENTIAL_SECRET=change-me-to-a-long-random-string
