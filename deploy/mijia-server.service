[Unit]
Description=Mijia API Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# User=mijia
# Group=mijia
WorkingDirectory=/opt/mijia_server
EnvironmentFile=-/etc/mijia-server.env
Environment=MIJIA_SERVER_HOST=127.0.0.1
Environment=MIJIA_SERVER_PORT=8123
Environment=MIJIA_SERVER_DATA_DIR=/opt/mijia_server/configs
Environment=MIJIA_SERVER_DATABASE_PATH=/opt/mijia_server/configs/server/server.sqlite3
Environment=MIJIA_CREDENTIAL_PATH=/opt/mijia_server/configs/credential.json
Environment=MIJIA_WEB_DIST_DIR=/opt/mijia_server/web/dist
ExecStart=/opt/mijia_server/.venv/bin/python -m server.cli run
Restart=always
RestartSec=3

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/mijia_server/configs /opt/mijia_server/.mijia

[Install]
WantedBy=multi-user.target
